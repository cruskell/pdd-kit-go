{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cruskell/proofsteer-go/docs/cli-output.schema.json",
  "title": "pdd CLI response envelope, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "plan", "ok", "exit_code"],
  "properties": {
    "schema": {"const": 1},
    "command": {"type": "string", "minLength": 1},
    "plan": {"type": "string"},
    "ok": {"type": "boolean"},
    "exit_code": {"enum": [0, 1, 2]},
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "hint": {"type": "string"}
      }
    }
  },
  "if": {"properties": {"ok": {"const": true}}},
  "then": {"properties": {"exit_code": {"const": 0}}, "not": {"required": ["error"]}},
  "else": {"properties": {"exit_code": {"enum": [1, 2]}}, "required": ["error"]}
}
